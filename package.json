{
  "name": "qunfang-edu",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev:api": "wrangler dev",
    "dev:web": "npm run dev -w web",
    "dev": "concurrently -n api,web -c green,blue npm:dev:api npm:dev:web",
    "build": "npm run build -w web",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && npm run typecheck -w web",
    "db:migrate:local": "wrangler d1 migrations apply qunfang --local",
    "db:migrate:remote": "wrangler d1 migrations apply qunfang --remote",
    "db:seed:local": "wrangler d1 execute qunfang --local --file=seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute qunfang --remote --file=seed/seed.sql",
    "start": "tsx server/server.ts",
    "cloudbase:build": "node scripts/build-cloudbase.mjs",
    "cloudbase:deploy": "node scripts/build-cloudbase.mjs && node scripts/install-cloudbase-deps.mjs && node scripts/deploy-cloudbase-fn.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.9.7",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@types/node": "^22",
    "@types/pg": "^8.15.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "wrangler": "^4.118.0"
  }
}
